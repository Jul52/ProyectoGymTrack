<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="20251027201908-2" author="jhipster">

    <addForeignKeyConstraint
      baseTableName="reservation"
      baseColumnNames="course_id"
      referencedTableName="course"
      referencedColumnNames="id"
      constraintName="fk_reservation_course"/>

    <addForeignKeyConstraint
      baseTableName="reservation"
      baseColumnNames="gym_service_id"
      referencedTableName="gym_service"
      referencedColumnNames="id"
      constraintName="fk_reservation_gym_service"/>

    <addForeignKeyConstraint
      baseTableName="reservation"
      baseColumnNames="registered_by_id"
      referencedTableName="user_data"
      referencedColumnNames="id"
      constraintName="fk_reservation_user_data"/>

    <addForeignKeyConstraint
      baseTableName="reservation"
      baseColumnNames="schedule_id"
      referencedTableName="schedule"
      referencedColumnNames="id"
      constraintName="fk_reservation_schedule"/>

  </changeSet>
</databaseChangeLog>
