<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Reservation.
    -->
    <changeSet id="20251027201908-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="course_id"
                                 baseTableName="reservation"
                                 constraintName="fk_reservation__course_id"
                                 referencedColumnNames="id"
                                 referencedTableName="course"
                                 />

        <addForeignKeyConstraint baseColumnNames="gym_service_id"
                                 baseTableName="reservation"
                                 constraintName="fk_reservation__gym_service_id"
                                 referencedColumnNames="id"
                                 referencedTableName="gym_service"
                                 />

        <addForeignKeyConstraint baseColumnNames="registered_by_id"
                                 baseTableName="reservation"
                                 constraintName="fk_reservation__user_data_id"
                                 referencedColumnNames="id"
                                 referencedTableName="user_data"
                                 />
    </changeSet>
</databaseChangeLog>
