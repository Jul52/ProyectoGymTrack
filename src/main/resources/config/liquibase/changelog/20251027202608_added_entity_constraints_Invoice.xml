<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Invoice.
    -->
    <changeSet id="20251027202608-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="payment_id"
                                 baseTableName="invoice"
                                 constraintName="fk_invoice__payment_id"
                                 referencedColumnNames="id"
                                 referencedTableName="payment"
                                 />

        <addForeignKeyConstraint baseColumnNames="payment_method_id"
                                 baseTableName="invoice"
                                 constraintName="fk_invoice__payment_method_id"
                                 referencedColumnNames="id"
                                 referencedTableName="payment_method"
                                 />

        <addForeignKeyConstraint baseColumnNames="user_data_id"
                                 baseTableName="invoice"
                                 constraintName="fk_invoice__user_data_id"
                                 referencedColumnNames="id"
                                 referencedTableName="user_data"
                                 />
    </changeSet>
</databaseChangeLog>
