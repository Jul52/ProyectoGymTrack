<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

  <changeSet id="20251027202408-1" author="jhipster">
    <createTable tableName="payment_method">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="method_name" type="varchar(50)">
        <constraints nullable="false"/>
      </column>
      <column name="method_code" type="varchar(30)">
        <constraints nullable="false" unique="true"/>
      </column>
      <column name="active" type="boolean" defaultValueBoolean="true">
        <constraints nullable="false"/>
      </column>
      <column name="uses_gateway" type="boolean" defaultValueBoolean="false"/>
    </createTable>
  </changeSet>

  <changeSet id="20251027202408-1-data" author="jhipster" context="faker">
    <loadData
      file="config/liquibase/fake-data/payment_method.csv"
      separator=";"
      tableName="payment_method"
      usePreparedStatements="true">
      <column name="id" type="numeric"/>
      <column name="method_name" type="string"/>
      <column name="method_code" type="string"/>
      <column name="active" type="boolean"/>
      <column name="uses_gateway" type="boolean"/>
    </loadData>
  </changeSet>

</databaseChangeLog>
