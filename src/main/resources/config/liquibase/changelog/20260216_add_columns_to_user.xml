<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

  <changeSet id="20260216-1" author="juliana">
    <preConditions onFail="MARK_RAN">
      <not>
        <columnExists tableName="qm_user" columnName="fecha_nacimiento"/>
      </not>
    </preConditions>
    <addColumn tableName="qm_user">
      <column name="fecha_nacimiento" type="date"/>
      <column name="numero_documento" type="varchar(20)"/>
      <column name="tipo_documento" type="varchar(20)"/>
    </addColumn>
  </changeSet>

</databaseChangeLog>
